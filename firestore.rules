rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownerOf(vendorId) {
      return signedIn()
        && exists(/databases/$(database)/documents/vendors/$(vendorId))
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerUid == request.auth.uid;
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin() || ownerOf(vendorId);
    }

    match /vendors/{vendorId}/menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin() || ownerOf(vendorId);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'student';
      allow update: if isAdmin() || (request.auth.uid == uid && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid
        || isAdmin() || ownerOf(resource.data.vendorId));
      allow create: if signedIn() && request.auth.uid == request.resource.data.studentUid;
      allow update, delete: if isAdmin() || (signedIn()
        && resource.data.studentUid == request.auth.uid
        && resource.data.status == 'Received');
    }
  }
}
